# Configuración del Servidor
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Proveedor de Traducción: "gemini" o "mock" (para pruebas locales sin gastar cuota)
TRANSLATION_PROVIDER=mock

# Clave de API de Google Gemini (Obtén la tuya gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_api_aqui

# Rutas de almacenamiento local
STORAGE_UPLOADS_DIR=../storage/uploads
STORAGE_PROCESSED_DIR=../storage/processed
